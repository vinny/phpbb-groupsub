{
	"name": "stevotvr/groupsub",
	"type": "phpbb-extension",
	"description": "An extension to allow members to access usergroups via paid subscription",
	"homepage": "https://github.com/vinny/phpbb-groupsub",
	"version": "2.0.0-dev",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Steve Guidetti",
			"email": "stevotvr@stevotvr.com",
			"homepage": "https://github.com/stevotvr",
			"role": "Original Developer"
		},
		{
			"name": "Vinny",
			"homepage": "https://github.com/vinny",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=8.2"
	},
	"extra": {
		"display-name": "Group Subscription",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0"
		},
		"version-check": {
			"host": "www.phpbb.com",
			"directory": "/customise/db/extension/groupsub",
			"filename": "version_check"
		}
	}
}
